# 1. Supabase Project Credentials (Project Ref: aixhmugoxwtwenishcfe)
SUPABASE_URL=https://aixhmugoxwtwenishcfe.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Payment Gateway: ZiniPay (Invoice API)
# Get from ZiniPay Dashboard -> Settings / API Keys
